{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartbreakfast",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "account_id": "2969b223537a288ce8813388a978eb2a",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Trả 404.html cho đường dẫn không tồn tại.
    "not_found_handling": "404-page",
    // Cho worker chạy trước mọi request để bắt được cả www trên đường dẫn ảnh.
    "run_worker_first": true
  },

  // Hai custom domain. Wrangler tự tạo bản ghi DNS trong zone cùng tài khoản.
  "routes": [
    { "pattern": "smartbreakfast.store", "custom_domain": true },
    { "pattern": "www.smartbreakfast.store", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
